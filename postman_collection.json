{
  "info": {
    "name": "Servicio de cedulas",
    "description": "Coleccion para probar el servicio FastAPI de generacion de cedulas aleatorias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Obtener cedula",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/obtener_cedula",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "obtener_cedula"
          ]
        },
        "description": "Devuelve un entero aleatorio de exactamente 10 digitos. No requiere body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const cedula = pm.response.json();",
              "pm.test('La cedula es un entero de 10 digitos', function () {",
              "    pm.expect(Number.isInteger(cedula)).to.be.true;",
              "    pm.expect(cedula).to.be.within(1000000000, 9999999999);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Obtener numero romano",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/obtener_numero_romano",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "obtener_numero_romano"
          ]
        },
        "description": "Devuelve la representacion romana de un numero aleatorio entre 50 y 100. No requiere body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const romano = pm.response.json();",
              "pm.test('La respuesta es un numero romano valido', function () {",
              "    pm.expect(romano).to.be.a('string');",
              "    pm.expect(romano).to.match(/^(L|L(I|V|X{0,3})|[LXCV]+|C)$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicar un numero",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/duplicar_numero?numero=7",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "duplicar_numero"
          ],
          "query": [
            {
              "key": "numero",
              "value": "7"
            }
          ]
        },
        "description": "Recibe un numero entero y devuelve el mismo valor multiplicado por 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const resultado = pm.response.json();",
              "pm.test('El numero fue multiplicado por 2', function () {",
              "    pm.expect(resultado).to.eql(14);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
